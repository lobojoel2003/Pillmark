root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[web/**]
indent_style = tab

[*.{json,webmanifest}]
indent_style = tab

[web/package-lock.json]
indent_style = space
indent_size = 2
