# Copy to .env for docker compose or local development.
POSTGRES_PASSWORD=pillmark
DATABASE_URL=postgresql://pillmark:pillmark@localhost:5432/pillmark
# Where the web server reaches the API, and where browsers can see it.
API_URL=http://127.0.0.1:8000
PUBLIC_API_URL=http://localhost:8000
# UTC time of day for the nightly DailyMed import (docker compose importer service).
PILLMARK_IMPORT_AT=07:30
